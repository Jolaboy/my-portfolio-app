# Copy to .env.local and fill values

# SMTP config used by /api/contact
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional: where contact emails should be delivered (defaults to SMTP_USER)
TO_EMAIL=

# Optional: if you host API separately, set a base URL used by the client components
# NEXT_PUBLIC_API_URL=
