# Copy to .env.local and fill with your SMTP credentials
#
# Gmail (recommended) (set these as real values in this file locally; never commit `.env.local`):
# - SMTP host: (see Gmail SMTP docs)
# - SMTP port: 587
# - SMTP secure: false
# - SMTP user: your Gmail address
# - SMTP pass: Google App Password (requires 2-Step Verification)
# - TO_EMAIL: optional recipient override

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
TO_EMAIL=
