# Copy to .env.local and fill with your SMTP credentials
#
# Gmail (recommended):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your Google App Password (requires 2-Step Verification)
# TO_EMAIL=recipient@example.com

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
TO_EMAIL=
